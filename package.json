{
  "name": "cardquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser card games with an AI opponent and peer-to-peer multiplayer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
